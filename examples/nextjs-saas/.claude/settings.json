{
  "model": "claude-sonnet-4-5",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git pull)",
      "Bash(git push)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(docker compose *)",
      "Bash(prisma *)",
      "Bash(stripe *)",
      "Bash(turbo *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo *)",
      "Bash(curl * | bash)",
      "Bash(stripe keys *)"
    ]
  },
  "env": {
    "NODE_ENV": "development",
    "TURBO_TELEMETRY_DISABLED": "1"
  },
  "hooks": {
    "PostToolUse": ".claude/hooks/post-tool-use.sh",
    "PreToolUse": ".claude/hooks/pre-tool-use.sh",
    "Stop": ".claude/hooks/stop.sh"
  }
}
