# =============================================================================
#  NexTask — Environment Variables
#  Copy to apps/web/.env.local — NEVER commit real values
# =============================================================================

# Database (docker compose sets this for local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextask_dev"

# Redis (docker compose sets this for local dev)
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="local_token"

# Auth (Auth.js v5)
AUTH_SECRET="run-openssl-rand-base64-32-to-generate"
AUTH_URL="http://localhost:3000"

# OAuth — create apps at console.developers.google.com and github.com/settings/apps
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Stripe — use TEST keys locally (pk_test_ / sk_test_)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""          # from: pnpm stripe:listen

# Stripe price IDs (from Stripe Dashboard — use test mode IDs locally)
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_TEAM_MONTHLY=""

# Email (Resend)
RESEND_API_KEY=""
FROM_EMAIL="noreply@nexttask.app"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
