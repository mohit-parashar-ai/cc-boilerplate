# =============================================================================
#  Helios — Environment Variables
#  Copy to .env — NEVER commit real values
# =============================================================================

# Database (docker compose sets this for local dev)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/helios_dev"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/helios_dev"

# Redis (broker for Celery + cache)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Auth
API_KEY_SALT="run-python3-secrets-token-hex-32-to-generate"

# ML models
MODEL_PATH="app/ml/models/anomaly_v2.pkl"
MODEL_THRESHOLD="0.85"

# App
APP_ENV="development"
DEBUG="true"
LOG_LEVEL="DEBUG"
APP_HOST="0.0.0.0"
APP_PORT="8000"

# Webhook delivery (optional)
WEBHOOK_SECRET="change-me"
WEBHOOK_TIMEOUT_SECONDS="10"

# Sentry (optional — leave blank for local dev)
SENTRY_DSN=""
